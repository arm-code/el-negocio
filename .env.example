# Variables del stack (docker-compose.yml). En Coolify se capturan en su pantalla
# de variables de entorno; en local, copia este archivo a `.env`.

# Contraseña de la base de datos (larga y aleatoria):  openssl rand -hex 24
POSTGRES_PASSWORD=

# Secreto para firmar las sesiones. El API y el front usan el MISMO:  openssl rand -hex 48
# Cambiarlo cierra todas las sesiones.
JWT_SECRET=

# Slug del negocio de esta instancia (el que creaste con create-business)
BUSINESS_SLUG=eventosmendoza

# Dominio público de esta instancia, sin barra final (vista previa al compartir y CORS)
SITE_URL=https://eventosmendoza.dejuarez.mx

# Contraseña del /docs del API (no se expone a internet, pero es obligatoria)
DOCS_PASSWORD=

# Optimizador de imágenes de Next (se fija al compilar el front).
#   false → funciona en CUALQUIER servidor (valor por defecto).
#   true  → reescala imágenes para móvil; SOLO si el CPU tiene SSE4.2. En CPUs viejos
#           (Core 2, etc.) el front se reinicia en bucle. Comprueba:  grep -c sse4_2 /proc/cpuinfo
#           (0 = no lo uses). Máquina de pruebas actual (Core 2 Duo): false. Producción: true.
IMAGE_OPTIMIZATION=false
