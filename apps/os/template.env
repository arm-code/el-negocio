# URL del API para el navegador. Relativa: el front reenvía /api al API
# (igual que en producción).
NEXT_PUBLIC_API_BASE_URL=/api
# URL del API para las páginas que se generan en el servidor (landing).
INTERNAL_API_URL=http://localhost:3500/api

# Mismo JWT_SECRET que el API: el proxy lo usa para verificar la cookie de sesión.
# Solo servidor: NUNCA con prefijo NEXT_PUBLIC_.
JWT_SECRET=cambia-esto-por-el-mismo-secreto-del-api
